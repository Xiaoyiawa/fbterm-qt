[Unit]
Description=QTFBTerm Qt framebuffer terminal
Documentation=file:///root/qt_fbterm/README.md
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/fb0

[Service]
Type=simple
WorkingDirectory=/root/qt_fbterm
Environment=QT_QPA_PLATFORM=linuxfb
Environment=QT_QPA_GENERIC_PLUGINS=none
Environment=QT_QPA_ENABLE_TERMINAL_KEYBOARD=0
Environment=XDG_RUNTIME_DIR=/run/qt_fbterm
Environment=HOME=/root
Environment=LANG=C.UTF-8
Environment=TERM=xterm-256color
RuntimeDirectory=qt_fbterm
RuntimeDirectoryMode=0700
ExecStart=/root/qt_fbterm/bin/qt_fbterm
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=5
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
