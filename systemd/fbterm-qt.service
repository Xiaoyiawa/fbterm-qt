[Unit]
Description=FBTERM-QT Qt framebuffer terminal
Documentation=file:///usr/share/fbterm-qt/README.md
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/fb0

[Service]
Type=simple
WorkingDirectory=/usr/share/fbterm-qt
Environment=QT_QPA_PLATFORM=linuxfb
Environment=QT_QPA_GENERIC_PLUGINS=none
Environment=QT_QPA_ENABLE_TERMINAL_KEYBOARD=0
Environment=XDG_RUNTIME_DIR=/run/fbterm-qt
Environment=HOME=/root
Environment=LANG=C.UTF-8
Environment=TERM=xterm-256color
RuntimeDirectory=fbterm-qt
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/fbterm-qt
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=5
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
