[Unit]
Description=LVFBTerm Qt framebuffer terminal
Documentation=file:///root/lvfbterm/README.md
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/fb0

[Service]
Type=simple
WorkingDirectory=/root/lvfbterm
Environment=QT_QPA_PLATFORM=linuxfb
Environment=QT_QPA_GENERIC_PLUGINS=none
Environment=QT_QPA_ENABLE_TERMINAL_KEYBOARD=0
Environment=XDG_RUNTIME_DIR=/run/lvfbterm
Environment=HOME=/root
Environment=LANG=C.UTF-8
RuntimeDirectory=lvfbterm
RuntimeDirectoryMode=0700
ExecStart=/root/lvfbterm/bin/lvfbterm
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=5
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
